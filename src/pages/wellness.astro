---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { mailto, site } from '../data/site';
import { products } from '../data/gallery';

const services = [
  { icon: 'users', title: 'Health awareness seminars', text: 'Presentations educating the public on avoidable risks of cancer and illness from chemicals in everyday products.' },
  { icon: 'search', title: 'Label reading help', text: '“I am happy to help you read labels and understand the chemicals you might be using.”' },
  { icon: 'leaf', title: 'Nutritional & beauty consulting', text: 'Certified guidance on clean nutritionals and safety-conscious skin, body, hair and beauty care.' },
  { icon: 'home', title: 'A non-toxic home', text: 'Safe household cleaning products and alternatives for your whole family — babies, men, women and pets.' },
] as const;

const pureHaven = [
  'Certified USDA organic options',
  'Skin, body & hair care',
  'Anti-aging & beauty cosmetics',
  'Household cleaning',
  'Products for babies, men, women & pets',
  'No harmful, questionable or known carcinogenic chemicals',
];

const watchlist = [
  { name: 'Parabens', note: 'Preservatives found in many lotions, cosmetics and shampoos' },
  { name: 'Formaldehyde & releasers', note: 'Used in some nail, hair and skin care products' },
  { name: 'Sodium lauryl sulfate', note: 'A foaming agent in shampoos, soaps and toothpastes' },
  { name: 'Cocamide DEA', note: 'A foaming and thickening agent in soaps and shampoos' },
  { name: 'Mineral oil & petrolatum', note: 'Petroleum-derived moisturizers and bases' },
  { name: 'Propylene glycol', note: 'A common humectant and solvent' },
  { name: 'Benzophenone', note: 'A UV filter used in sunscreens and cosmetics' },
  { name: '“Fragrance”', note: 'One word that can hide many undisclosed ingredients' },
];

const books = [
  { title: 'The Safe Shopper’s Bible', by: 'Samuel S. Epstein, M.D. & David Steinman, 1995' },
  { title: 'Toxic Beauty', by: 'Samuel S. Epstein, M.D. with Randall Fitzgerald, 2009' },
  { title: 'Unreasonable Risk: How to Avoid Cancer from Cosmetics and Personal Care Products', by: 'Samuel S. Epstein, M.D., 2001' },
  { title: 'The Politics of Cancer Revisited', by: 'Samuel S. Epstein, M.D., 1998' },
  { title: 'Cancer-Gate: How to Win the Losing Cancer War', by: 'Samuel S. Epstein, M.D., 2005' },
  { title: 'Not Just a Pretty Face', by: 'Stacy Malkan' },
  { title: 'Beauty to Die For', by: 'Judi Vance' },
  { title: 'Nontoxic Homes', by: 'Debra Lynn Dadd' },
];

const orgs = [
  { name: 'Campaign for Safe Cosmetics', href: 'https://www.safecosmetics.org/' },
  { name: 'Environmental Working Group', href: 'https://www.ewg.org/' },
  { name: 'Silent Spring Institute', href: 'https://www.silentspring.org/' },
];

const faqs = [
  { q: 'Can I get a discount on essential oils?', a: 'Yes. Browse the Time Labs website, then contact Shelley with what you’d like. Orders placed through her receive a 15–25% discount.' },
  { q: 'Do you give presentations to groups?', a: 'Yes. Shelley provides health awareness seminars on chemicals in everyday products and how to choose safer alternatives. Get in touch to arrange one.' },
  { q: 'Can you help me choose products for my family?', a: 'Absolutely. Tell Shelley who you’re shopping for — babies, sensitive skin, men, women, even pets — and she’ll help you find safe options.' },
  { q: 'Is this medical advice?', a: 'No. Shelley provides education and product guidance. For any medical condition, please work with your physician or a qualified health professional.' },
];
---

<Base title="Wellness & Safe Products" description="Safe, pure and trusted products for body and home — Pure Haven clean beauty, pure essential oils from Time Labs, mineral sunscreen guidance, cancer prevention education and a consumer guide to reading labels, from Shelley Marks-Kramer.">
  <PageHero
    eyebrow="Treat yourself with love & affection"
    title='Safe, pure &amp; <em class="accent">trusted</em> products for body and home'
    lede="I advocate for the use of natural remedies for your body and home, together with clean water, clean air and non-toxic products."
  >
    <div slot="actions" class="btn-row reveal" style="--delay:.24s; margin-top: 2rem">
      <a href="#products" class="btn">See the products <Icon name="arrow" /></a>
      <a href="#consumer-guide" class="btn btn--ghost">Consumer guide</a>
    </div>
    <div class="hero-stat reveal" style="--delay:.3s">
      <img src={products['green-business'].src} alt="Certified Green Business League" width="88" height="88" />
      <p><strong>Safety-conscious, certified green.</strong> Safe, effective, affordable — and non-toxic, with no harmful, questionable or known carcinogenic chemicals.</p>
    </div>
  </PageHero>

  <!-- How I can help -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">How I can help you</span>
        <h2>With your decisions on health product choices</h2>
      </div>
      <div class="grid grid-4">
        {
          services.map((s, i) => (
            <div class="card card--hover reveal" style={`--delay:${i * 0.06}s`}>
              <span class="icon-badge"><Icon name={s.icon} /></span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Products -->
  <section class="section section--paper" id="products">
    <div class="container">
      <div class="section-head section-head--center reveal">
        <span class="eyebrow">Safety-conscious companies</span>
        <h2>Two favorite product lines, <em class="accent">clean &amp; safe</em></h2>
        <p class="lede">Products Shelley uses herself and recommends to her family, friends and clients.</p>
      </div>

      <article class="feature card reveal">
        <div class="feature__media">
          <Photo photo={products['bottles']} alt="Pure Haven personal care products" />
        </div>
        <div class="feature__body">
          <div class="feature__brand">
            <img src={products['pure-haven-logo'].src} alt="Pure Haven Essentials" width="72" height="72" />
            <span class="pill">Beauty, body &amp; home</span>
          </div>
          <h3>Pure Haven</h3>
          <p>
            Safe, trusted, pure, organic, non-toxic personal care, anti-aging, beauty and home cleaning products. Pure
            Haven has made the “best company” list of safest products, and its sunscreen has been among the best rated by
            EWG. Shelley has been using Pure Haven for over eight years.
          </p>
          <ul class="check-list cols">
            {pureHaven.map((p) => <li>{p}</li>)}
          </ul>
          <div class="btn-row">
            <a href={mailto('Pure Haven order')} class="btn btn--clay">Order through Shelley <Icon name="arrow" /></a>
            <a href={site.shops.pureHaven} class="btn btn--ghost" target="_blank" rel="noopener">Browse Pure Haven <Icon name="external" /></a>
          </div>
        </div>
      </article>

      <div class="grid grid-2 mt-lg">
        <article class="card product reveal">
          <Photo photo={products['essential-oils']} ratio="16/9" alt="Bottles of pure essential oils" />
          <div class="product__top">
            <span class="pill">Essential oils</span>
            <span class="pill pill--clay">15–25% off through Shelley</span>
          </div>
          <h3>Pure, unadulterated essential oils from Time Labs</h3>
          <p>
            Time Labs is a private-label manufacturer of some of the world’s best essential oils, in business for more than
            30 years. Essential oils have been part of Shelley’s health collection for over 25 years — she knows the owner,
            and orders placed through her receive a 15–25% discount.
          </p>
          <div class="btn-row">
            <a href={mailto('Essential oils order (Time Labs)')} class="btn">Order with discount <Icon name="arrow" /></a>
            <a href={site.shops.timeLabs} class="btn btn--ghost" target="_blank" rel="noopener">Browse Time Labs <Icon name="external" /></a>
          </div>
        </article>

        <article class="card product reveal" style="--delay:.08s">
          <Photo photo={products['cbd-oil']} ratio="16/9" alt="Pure Haven CBD comfort oil roller bottle" />
          <div class="product__top">
            <span class="pill">Shelley’s favorite</span>
          </div>
          <h3>CBD comfort oil</h3>
          <blockquote class="product__quote">
            “This is an amazing product. I used it on my dry skin and rash and the next day started seeing healing results.
            Within a few days the rash was almost gone.”
          </blockquote>
          <p>
            Nourishing CBD (0% THC) with organic sunflower, jojoba, frankincense, roman chamomile and lavender oils, in a
            convenient roller ball to moisturize and comfort dry skin and relieve achy muscles.
          </p>
          <a href={mailto('CBD comfort oil')} class="link-arrow">Ask Shelley <Icon name="arrow" size={16} /></a>
        </article>
      </div>

      <p class="center muted mt-lg">
        Shelley has also used Modere’s clean nutritionals for many years —
        <a href={mailto('Nutritional products')} class="link-arrow">ask her about nutrition</a>
      </p>
    </div>
  </section>

  <!-- Sunscreen -->
  <section class="section" id="sunscreen">
    <div class="container split">
      <div>
        <span class="eyebrow reveal">Skip the uncertainty, not the sunscreen</span>
        <h2 class="reveal" style="margin-block:1rem 1.25rem">Choosing a <em class="accent">safer</em> sunscreen</h2>
        <div class="prose reveal">
          <p>
            About 5 million cases of skin cancer are diagnosed each year, more than 90% attributed to UV exposure — so
            sunscreen matters. But the FDA has asked for more safety information on common chemical UV filters such as
            oxybenzone, avobenzone, homosalate, octinoxate, octisalate and octocrylene.
          </p>
          <p>
            Pure Haven’s sunscreen uses <strong>non-nanoparticle titanium dioxide (6%) and zinc oxide (6%)</strong> —
            minerals that sit on the surface of the skin and deflect UV rays rather than absorbing them.
          </p>
        </div>
      </div>
      <div class="card sun reveal" style="--delay:.1s">
        <Photo photo={products.sunscreen} ratio="3/1" alt="Pure Haven mineral sunscreen tubes on sand" />
        <h3>Tips for sunscreen use</h3>
        <ul class="check-list">
          <li>Use a shot glass full (about 1 oz) of lotion for your entire body.</li>
          <li>Seek shade between 10 a.m. and 2 p.m., when the sun’s rays are strongest.</li>
          <li>Wear sun-protective clothing.</li>
          <li>Choose lotions or sticks over sprays, which may be unsafe to inhale and make it easy to miss spots.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Cancer prevention -->
  <section class="section section--forest" id="cancer-prevention">
    <div class="container split" style="align-items:start">
      <div class="reveal">
        <span class="eyebrow" style="color:#f3b79f">Cancer prevention education</span>
        <h2 style="margin-top:1rem">The more cancer is prevented, the less there is to treat</h2>
        <p class="lede" style="color:rgb(231 239 230 / .8); margin-top:1.25rem">
          Shelley has served as Los Angeles director of the Cancer Prevention Coalition since 1987.
        </p>
      </div>
      <div class="prose prose--light reveal" style="--delay:.1s">
        <p>
          The Cancer Prevention Coalition was founded by Dr. Samuel S. Epstein, M.D., professor emeritus of environmental
          and occupational medicine at the University of Illinois at Chicago School of Public Health. An internationally
          recognized expert on avoidable causes of cancer, he published hundreds of peer-reviewed articles and authored or
          co-authored books including <em>The Politics of Cancer</em>, <em>The Safe Shopper’s Bible</em> and
          <em>Toxic Beauty</em>.
        </p>
        <p>
          “Our dear Dr. Samuel Epstein passed away in 2018, at a ripe old 91 years of age. We will remember him with
          reverence and compassion. He was a maverick and one of a kind, and all of us who knew him personally will miss
          him tremendously.”
        </p>
        <p>
          Everyday products such as shampoo, deodorant and make-up can contain chemicals of concern. Through seminars and
          scientific literature, Shelley helps people learn which ingredients to question and which safer alternatives are
          available.
        </p>
        <a href={mailto('Cancer prevention seminar or information')} class="btn btn--light" style="margin-top:1rem">
          Request a seminar or information <Icon name="arrow" />
        </a>
      </div>
    </div>
  </section>

  <!-- Consumer guide -->
  <section class="section" id="consumer-guide">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Your decisions as health product consumers</span>
        <h2>How to become a <em class="accent">wise</em> health consumer</h2>
        <p class="lede">
          “Which one should I choose?” The choices you make are important, especially when they concern your health.
        </p>
      </div>

      <div class="facts reveal">
        <div>
          <strong>1938</strong>
          <p>The year the U.S. law governing cosmetics was written. It went largely unchanged until the Modernization of Cosmetics Regulation Act of 2022.</p>
        </div>
        <div>
          <strong>125+</strong>
          <p>Known carcinogens in daily personal hygiene and beauty products, according to General Accounting Office information Senator Ted Kennedy presented to Congress in 1997.</p>
        </div>
        <div>
          <strong>800+</strong>
          <p>Chemicals available for use in cosmetics that have been reported to the government as toxic substances, according to NIOSH.</p>
        </div>
      </div>

      <div class="guide mt-lg">
        <div class="reveal">
          <h3>Ask before you buy</h3>
          <p>
            Many people have learned that the most costly products are not always the best ones. Ask: what ingredients
            are in this product and what do they mean? Can I buy something better if I take more time to look and think
            about it?
          </p>
        </div>
        <div class="reveal" style="--delay:.06s">
          <h3>Know where to look</h3>
          <p>
            Public health educators, cancer prevention educators, nurses, pharmacists and doctors can advise you. Material
            Safety Data Sheets list the chemicals in everyday products and their measure of safety or hazard. News
            reports, scientific articles and your library are good sources, too.
          </p>
        </div>
        <div class="reveal" style="--delay:.12s">
          <h3>Look past the advertising</h3>
          <p>
            Some ads give helpful information; many don’t. Scientific claims can be checked against the facts in writing.
            Often a shampoo costs more simply because of its fancy container — the cap can cost more than the shampoo.
          </p>
        </div>
      </div>

      <div class="split mt-lg" style="align-items:start">
        <div class="card reveal">
          <span class="icon-badge icon-badge--clay"><Icon name="search" /></span>
          <h3>Ingredients Shelley teaches people to look for</h3>
          <p>These controversial and questionable ingredients come up again and again in her seminars.</p>
          <dl class="watch">
            {
              watchlist.map((w) => (
                <div>
                  <dt>{w.name}</dt>
                  <dd>{w.note}</dd>
                </div>
              ))
            }
          </dl>
        </div>
        <div class="card reveal" style="--delay:.08s">
          <span class="icon-badge"><Icon name="book" /></span>
          <h3>Recommended reading</h3>
          <ul class="books">
            {
              books.map((b) => (
                <li>
                  <strong>{b.title}</strong>
                  <span>{b.by}</span>
                </li>
              ))
            }
          </ul>
          <p class="orgs">
            Online:
            {orgs.map((o, i) => <>{i > 0 && ' · '}<a href={o.href} target="_blank" rel="noopener">{o.name}</a></>)}
          </p>
        </div>
      </div>

      <p class="closing reveal">
        Once you are an informed consumer and you learn about the chemicals and ingredients in your products, you can make
        informed decisions and wise choices. <strong>Protecting your health and skin should be of utmost importance to you and your family.</strong>
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--paper">
    <div class="container split split--wide-left" style="align-items:start">
      <div class="faq">
        <div class="section-head reveal">
          <span class="eyebrow">Questions</span>
          <h2>Good to know</h2>
        </div>
        {
          faqs.map((f) => (
            <details class="reveal">
              <summary>
                {f.q}
                <span aria-hidden="true" class="faq__plus" />
              </summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
      <aside class="card note reveal">
        <span class="icon-badge icon-badge--sky"><Icon name="book" /></span>
        <h3>A gentle reminder</h3>
        <p>
          The information shared here is educational and is not intended to diagnose, treat, cure or prevent any disease.
          Always talk with your physician before changing your health routine.
        </p>
      </aside>
    </div>
  </section>

  <CtaBand title='Questions about a product or ingredient?' text="Send Shelley a photo of a label or a list of what you use. She’ll help you make sense of it — and suggest safe, trusted alternatives." />
</Base>

<style>
  .hero-stat {
    display: flex;
    gap: 1.2rem;
    align-items: center;
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    background: rgb(255 255 255 / 0.8);
    border: 1px solid var(--line);
    backdrop-filter: blur(8px);
    box-shadow: var(--shadow);
    color: var(--ink-soft);
    max-width: 440px;
    justify-self: end;
  }
  .hero-stat img {
    flex: none;
    width: 88px;
    height: 88px;
  }
  .hero-stat strong {
    color: var(--forest-deep);
  }

  .feature {
    display: grid;
    gap: 2rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    align-items: center;
  }
  @media (min-width: 900px) {
    .feature {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 3rem;
    }
  }
  .feature__media :global(.photo) {
    border-radius: var(--radius);
  }
  .feature__brand {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .feature__brand img {
    width: 72px;
    height: 72px;
    border-radius: 16px;
  }
  .feature h3 {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
  }
  .check-list.cols {
    margin-block: 1.5rem 2rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
  }
  .pill--clay {
    background: var(--clay-soft);
    color: var(--clay-deep);
  }

  .product {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .product__top {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }
  .product h3 {
    margin: 0;
  }
  .product > p {
    flex: 1;
  }
  .product__quote {
    font-family: var(--font-display);
    font-size: 1.1rem;
    line-height: 1.4;
    color: var(--forest-deep);
    padding-left: 1rem;
    border-left: 3px solid var(--clay);
  }

  .sun {
    display: grid;
    gap: 1.25rem;
  }

  .prose--light p {
    color: rgb(231 239 230 / 0.85);
    font-size: 1.05rem;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 1.5rem;
  }
  .facts > div {
    padding: 1.75rem;
    border-radius: var(--radius);
    background: var(--paper);
  }
  .facts strong {
    display: block;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.4rem, 4vw, 3.2rem);
    line-height: 1;
    color: var(--clay);
    margin-bottom: 0.75rem;
  }
  .facts p {
    color: var(--ink-soft);
    font-size: 0.97rem;
  }
  .guide {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 2rem;
  }
  .guide h3 {
    margin-bottom: 0.5rem;
  }
  .guide p {
    color: var(--ink-soft);
  }
  .watch {
    display: grid;
    margin-top: 1rem;
  }
  .watch div {
    padding-block: 0.75rem;
    border-bottom: 1px dashed var(--line);
  }
  .watch dt {
    font-weight: 600;
    color: var(--forest-deep);
  }
  .watch dd {
    margin: 0;
    font-size: 0.92rem;
    color: var(--ink-soft);
  }
  .books {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.8rem;
    margin-block: 1rem;
  }
  .books li {
    display: grid;
  }
  .books strong {
    font-family: var(--font-display);
    font-weight: 500;
    color: var(--forest-deep);
  }
  .books span {
    font-size: 0.88rem;
    color: var(--ink-mute);
  }
  .orgs {
    font-size: 0.92rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .orgs a {
    color: var(--clay-deep);
  }
  .closing {
    max-width: 760px;
    margin: clamp(2.5rem, 5vw, 4rem) auto 0;
    text-align: center;
    font-size: 1.15rem;
    color: var(--ink-soft);
  }
  .closing strong {
    color: var(--forest-deep);
  }

  .faq details {
    border-bottom: 1px solid var(--line);
  }
  .faq summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.4rem 0;
    cursor: pointer;
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--forest-deep);
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq__plus {
    position: relative;
    flex: none;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--white);
  }
  .faq__plus::before,
  .faq__plus::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 1.5px;
    background: var(--forest);
    translate: -50% -50%;
    transition: rotate 0.3s var(--ease);
  }
  .faq__plus::after {
    rotate: 90deg;
  }
  details[open] .faq__plus::after {
    rotate: 0deg;
  }
  .faq details p {
    padding-bottom: 1.4rem;
    color: var(--ink-soft);
    max-width: 60ch;
  }
  .note {
    position: sticky;
    top: 110px;
  }
</style>
