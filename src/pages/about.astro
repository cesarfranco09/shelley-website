---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Artwork from '../components/Artwork.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';

const timeline = [
  {
    year: '1974',
    title: 'Creative Environments Flowers & Plantscapes',
    text: 'Shelley’s first business brought tropical paradises indoors — interior flowers, plantscapes and artwork for homes, offices, restaurants, showrooms, parties, weddings and bar/bat mitzvahs.',
  },
  {
    year: '1983',
    title: 'Art on the walls — and in the world',
    text: 'She began showing and exhibiting her artwork across the United States, from Santa Monica to New York City, building a community of collectors from coast to coast.',
  },
  {
    year: 'Survivor',
    title: 'A turning point',
    text: 'Surviving cancer changed everything. Shelley made it her second-half-of-life mission to educate the public about the risks of toxic ingredients in everyday products.',
  },
  {
    year: 'Educator',
    title: 'Cancer Prevention Coalition — Los Angeles',
    text: 'Appointed director of the local Los Angeles office of the Cancer Prevention Coalition, founded by Dr. Samuel S. Epstein, M.D., to raise awareness of avoidable causes of cancer.',
  },
  {
    year: 'Today',
    title: 'Healthy Communications',
    text: 'Combining college degrees, certification in nutritional consulting and decades of hands-on experience to guide families toward safer choices — while painting every chance she gets.',
  },
];

const values = [
  { icon: 'heart', title: 'Warm & caring', text: 'Every conversation starts with listening. Your health goals, your pace.' },
  { icon: 'book', title: 'Education first', text: 'Understand the “why” behind every recommendation so you can decide with confidence.' },
  { icon: 'shield', title: 'Trusted sources', text: 'Only products from established manufacturers with decades-long track records.' },
  { icon: 'sparkles', title: 'Mind, body & spirit', text: 'Wellness is more than ingredients — beauty and creativity heal, too.' },
] as const;
---

<Base title="About Shelley" description="Meet Shelley Marks-Kramer — entrepreneur since 1974, cancer survivor, Cancer Prevention Coalition director in Los Angeles, nutritional consultant, safe-products educator and impressionist artist.">
  <PageHero
    eyebrow="About Shelley"
    title='Health professional, educator &amp; <em class="accent">lifelong artist</em>'
    lede="Shelley Marks-Kramer is a warm and caring health professional and artist whose energy, breadth of knowledge and spirituality make her a true healer — and a trusted guide for anyone ready to live a little cleaner."
  >
    <div class="about-hero-art reveal" style="--delay:.2s">
      <Artwork kind="sunset" seed={9} ratio="4/5" eager />
    </div>
  </PageHero>

  <section class="section">
    <div class="container split">
      <div class="prose reveal">
        <span class="eyebrow">Her story</span>
        <h2>Self-employed for more than three-quarters of her life</h2>
        <p>
          Shelley has been starting and running her own businesses for most of her life. She holds several college
          degrees, years of hands-on experience, and certifications in nutritional consulting — and she brings every bit
          of that to the people she works with.
        </p>
        <p>
          Her path to wellness education is personal. As a cancer survivor, Shelley is passionate about helping
          consumers recognize harmful ingredients in the personal care products, beauty cosmetics and household
          cleaners they use every day — and about pointing them toward safe, effective alternatives.
        </p>
        <p>
          Alongside her health work, Shelley has created art her entire life, in crayon, pastel, acrylic and
          watercolor, oil crayon, pen and ink, etchings, sketches, greeting cards, mosaics and digital iPad painting.
        </p>
      </div>
      <div class="values reveal" style="--delay:.1s">
        {
          values.map((v) => (
            <div class="values__item">
              <span class="icon-badge"><Icon name={v.icon} /></span>
              <div>
                <h3>{v.title}</h3>
                <p>{v.text}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--paper">
    <div class="container">
      <div class="section-head section-head--center reveal">
        <span class="eyebrow">Milestones</span>
        <h2>A journey of <em class="accent">beauty &amp; purpose</em></h2>
      </div>
      <ol class="timeline">
        {
          timeline.map((t, i) => (
            <li class="reveal" style={`--delay:${i * 0.05}s`}>
              <span class="timeline__year">{t.year}</span>
              <div class="timeline__body">
                <h3>{t.title}</h3>
                <p>{t.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="roles grid grid-3">
        <div class="card reveal">
          <span class="icon-badge icon-badge--clay"><Icon name="ribbon" /></span>
          <h3>Cancer prevention advocate</h3>
          <p>Director of the local Los Angeles office of the Cancer Prevention Coalition, sharing information on reducing avoidable exposures.</p>
        </div>
        <div class="card reveal" style="--delay:.08s">
          <span class="icon-badge"><Icon name="leaf" /></span>
          <h3>Nutritional consultant</h3>
          <p>Certified in nutritional consulting, helping clients choose clean, well-made nutritional products that fit their lives.</p>
        </div>
        <div class="card reveal" style="--delay:.16s">
          <span class="icon-badge icon-badge--gold"><Icon name="sparkles" /></span>
          <h3>Safe products &amp; beauty consultant</h3>
          <p>An educator on safe products for body and home, and a beauty consultant for clean, non-toxic cosmetics.</p>
        </div>
      </div>
    </div>
  </section>

  <CtaBand title='Let’s start a conversation' text="Have a question about a product, an ingredient, or a painting you love? Shelley personally answers every message." />
</Base>

<style>
  .about-hero-art {
    max-width: 380px;
    justify-self: end;
    width: 100%;
    padding: 10px;
    background: #fff;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    rotate: 3deg;
  }
  .prose h2 {
    margin-block: 1rem 0.5rem;
  }
  .values {
    display: grid;
    gap: 1rem;
  }
  .values__item {
    display: flex;
    gap: 1.2rem;
    padding: 1.4rem;
    border-radius: var(--radius);
    background: var(--white);
    border: 1px solid var(--line);
  }
  .values__item .icon-badge {
    margin: 0;
    flex: none;
  }
  .values__item h3 {
    font-size: 1.25rem;
    margin-bottom: 0.25rem;
  }
  .values__item p {
    color: var(--ink-soft);
    font-size: 0.97rem;
  }

  .timeline {
    list-style: none;
    padding: 0;
    max-width: 860px;
    margin-inline: auto;
    position: relative;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 7.5rem;
    top: 0.6rem;
    bottom: 0.6rem;
    width: 1px;
    background: linear-gradient(var(--clay), var(--sage));
  }
  .timeline li {
    position: relative;
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 2.5rem;
    padding-block: 1.6rem;
  }
  .timeline li::after {
    content: '';
    position: absolute;
    left: calc(7.5rem - 6px);
    top: 2.1rem;
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: var(--cream);
    border: 3px solid var(--clay);
  }
  .timeline__year {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--clay);
    text-align: right;
    padding-right: 0.5rem;
    line-height: 1.3;
  }
  .timeline__body h3 {
    margin-bottom: 0.4rem;
  }
  .timeline__body p {
    color: var(--ink-soft);
  }
  @media (max-width: 640px) {
    .timeline::before {
      left: 6px;
    }
    .timeline li {
      grid-template-columns: 1fr;
      gap: 0.4rem;
      padding-left: 2rem;
    }
    .timeline li::after {
      left: 0;
      top: 2rem;
    }
    .timeline__year {
      text-align: left;
      font-size: 1.2rem;
    }
  }
</style>
