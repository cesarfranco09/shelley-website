---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { mailto, site } from '../data/site';
import { acrylic, watercolor, mosaic, digital, embroidery, masks, puzzles } from '../data/gallery';

const works = [
  ...acrylic.map((p) => ({ ...p, medium: 'Acrylic' })),
  ...watercolor.map((p) => ({ ...p, medium: 'Watercolor' })),
  ...mosaic.map((p) => ({ ...p, medium: 'Mosaic' })),
  ...digital.map((p) => ({ ...p, medium: 'Digital' })),
];
// Interleave mediums so "All" shows a varied mix.
const buckets = ['Acrylic', 'Watercolor', 'Mosaic', 'Digital'].map((m) => works.filter((w) => w.medium === m));
const mixed: typeof works = [];
for (let i = 0; buckets.some((b) => b[i]); i++) buckets.forEach((b) => b[i] && mixed.push(b[i]));

const filters = [
  { label: 'All', count: works.length },
  ...['Acrylic', 'Watercolor', 'Mosaic', 'Digital'].map((m) => ({ label: m, count: works.filter((w) => w.medium === m).length })),
];

const gems = [
  ['Agate', 'good luck'], ['Amber', 'protection'], ['Amethyst', 'love'], ['Green aventurine', 'good luck'],
  ['Bloodstone', 'good health'], ['Blue agate', 'calming'], ['Carnelian', 'energy, creativity'], ['Calcite', 'protection'],
  ['Citrine', 'protection from negativity'], ['Copper', 'healing'], ['Fluorite', 'cleansing'], ['Jade', 'wealth'],
  ['Garnet', 'romance'], ['Mahogany jasper', 'harmony'], ['Malachite', 'healing'], ['Lapis', 'calming, healing'],
  ['Moonstone', 'balancing'], ['Peridot', 'protection'], ['Red jasper', 'harmony'], ['Clear quartz', 'purity'],
  ['Rose quartz', 'balance'], ['Smoky quartz', 'grounding'], ['Sodalite', 'tranquility'], ['Turquoise', 'healing'],
  ['Tourmaline', 'balancing'], ['Tree agate', 'peace'], ['Unakite', 'trust'],
];

const jewelryPrices = [
  ['Earrings', 'from $15–$25'],
  ['Necklaces', 'from $50–$100'],
  ['Watches', '$25–$75'],
  ['Complete sets', 'up to $249'],
];

const mosaicPrices = [
  ['Wall art, stepping stones & garden art', 'from $150'],
  ['Mosaic pottery, 12″ pots', 'from $150'],
  ['Mosaic pottery, 8″ pots', 'from $100'],
  ['Four-sided mailboxes', 'from $150 per side'],
  ['House, apartment & condo numbers', '$25 per number, $100 minimum'],
];
---

<Base title="Art & Handmade" description="Fine impressionist art by Shelley Marks-Kramer — acrylic and watercolor paintings, mosaics and digital iPad art, plus healing gemstone jewelry, embroidery, handmade masks and puzzles. All artwork is for sale.">
  <PageHero
    eyebrow="Fine impressionist art"
    title='Paintings, mosaics &amp; <em class="accent">handmade treasures</em>'
    lede="I have been creating art my entire life, using crayons, pastels, acrylic and watercolor paints, oil crayons, pen and ink and gouache — oceanscapes, landscapes, peoplescapes, windowscapes and floral arrangements painted from live flowers."
  >
    <div slot="actions" class="btn-row reveal" style="--delay:.24s; margin-top: 2rem">
      <a href="#gallery" class="btn">View the gallery <Icon name="arrow" /></a>
      <a href={site.social.artSite} class="btn btn--ghost" target="_blank" rel="noopener">Shelley-Marks-Kramer.com <Icon name="external" /></a>
    </div>
    <div class="palette-card reveal" style="--delay:.3s">
      <p class="palette-card__title">All artwork is for sale</p>
      <p>
        Shown and exhibited since 1983, from Santa Monica to New York City, with collectors across the U.S. Commissions
        welcome.
      </p>
      <a href={mailto('Art pricing inquiry')} class="link-arrow">Ask about pricing <Icon name="arrow" size={16} /></a>
    </div>
  </PageHero>

  <!-- Gallery -->
  <section class="section" id="gallery">
    <div class="container">
      <div class="gallery-head">
        <div class="section-head reveal" style="margin-bottom:0">
          <span class="eyebrow">Gallery</span>
          <h2>Selected works</h2>
        </div>
        <div class="filters reveal" role="group" aria-label="Filter artwork by medium">
          {
            filters.map((f, i) => (
              <button type="button" data-filter={f.label} aria-pressed={i === 0 ? 'true' : 'false'}>
                {f.label} <span>{f.count}</span>
              </button>
            ))
          }
        </div>
      </div>

      <ul class="masonry" data-gallery>
        {
          mixed.map((w) => (
            <li data-medium={w.medium}>
              <button type="button" class="work" aria-label={`View ${w.title}, ${w.medium}`}>
                <Photo photo={w} alt={`${w.title} — ${w.medium.toLowerCase()} by Shelley Marks-Kramer`} sizes="(min-width: 900px) 33vw, 50vw" />
                <span class="work__meta">
                  <strong>{w.title}</strong>
                  <span>{w.detail}</span>
                </span>
              </button>
            </li>
          ))
        }
      </ul>
      <p class="center muted mt-lg">
        Interested in a piece or a commission? <a href={mailto('Art inquiry')} class="link-arrow">Ask about availability</a>
      </p>
    </div>
  </section>

  <!-- Lightbox -->
  <dialog class="lightbox" data-lightbox aria-label="Artwork viewer">
    <button type="button" class="lightbox__close" data-close aria-label="Close"><Icon name="close" /></button>
    <button type="button" class="lightbox__nav lightbox__nav--prev" data-prev aria-label="Previous"><Icon name="arrow" /></button>
    <figure>
      <img data-img alt="" />
      <figcaption>
        <strong data-title></strong>
        <span data-medium></span>
      </figcaption>
    </figure>
    <button type="button" class="lightbox__nav" data-next aria-label="Next"><Icon name="arrow" /></button>
  </dialog>

  <!-- Mosaic commissions -->
  <section class="section section--paper" id="mosaics">
    <div class="container split">
      <div class="mosaic-photos reveal">
        <Photo photo={mosaic[0]} ratio="3/4" alt="Mosaic stepping stone of Shelley’s hand" />
        <Photo photo={mosaic[2]} ratio="3/4" alt="The Sun with Dishes mosaic wall" />
      </div>
      <div>
        <span class="eyebrow reveal">One-of-a-kind mosaics</span>
        <h2 class="reveal" style="margin-block:1rem 1.25rem">Made from glass, tiles, dishes, mirrors, jewelry — <em class="accent">or your items</em></h2>
        <p class="lede reveal">
          Wall hangings, pottery, candle holders, flower vases, mailboxes, boxes, stepping stones, trivets and house
          numbers. Grout can be many different colors.
        </p>
        <dl class="prices reveal">
          {
            mosaicPrices.map(([k, v]) => (
              <div>
                <dt>{k}</dt>
                <dd>{v}</dd>
              </div>
            ))
          }
        </dl>
        <a href={mailto('Mosaic commission')} class="btn btn--clay reveal">Commission a mosaic <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- Jewelry -->
  <section class="section" id="jewelry">
    <div class="container split" style="align-items:start">
      <div>
        <span class="eyebrow reveal">Healing / energy jewelry</span>
        <h2 class="reveal" style="margin-block:1rem 1.25rem">Jewelry to <em class="accent">adorn the soul</em></h2>
        <p class="lede reveal">
          Necklaces, earrings, bracelets, eyeglass holders, watches, hair ornaments and key rings, handmade with love from
          crystals and semi-precious natural gemstones — used for thousands of years for healing, balancing the chakras,
          cleansing, love and much more.
        </p>
        <dl class="prices reveal">
          {
            jewelryPrices.map(([k, v]) => (
              <div>
                <dt>{k}</dt>
                <dd>{v}</dd>
              </div>
            ))
          }
        </dl>
        <p class="muted reveal">Prices vary with the stones used and combination orders of necklace, earrings and bracelet.</p>
        <a href={mailto('Gemstone jewelry')} class="btn btn--clay reveal" style="margin-top:1.5rem">Order jewelry <Icon name="arrow" /></a>
      </div>
      <div class="card gems reveal" style="--delay:.1s">
        <span class="icon-badge icon-badge--gold"><Icon name="gem" /></span>
        <h3>Stones used in Shelley’s jewelry</h3>
        <ul>
          {
            gems.map(([g, m]) => (
              <li>
                <strong>{g}</strong>
                <span>{m}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Masks & embroidery -->
  <section class="section section--paper" id="handmade">
    <div class="container">
      <div class="section-head section-head--center reveal">
        <span class="eyebrow">Handmade by Shelley</span>
        <h2>Masks &amp; <em class="accent">embroidery</em></h2>
        <p class="lede">Handmade cotton masks — all one of a kind — and embroidery on clothing, pillows and more.</p>
      </div>
      <div class="handmade-grid">
        {
          [...masks, ...embroidery].map((p, i) => (
            <figure class="reveal" style={`--delay:${(i % 4) * 0.05}s`}>
              <Photo photo={p} ratio="1/1" alt={`${p.title} — ${p.detail?.toLowerCase()} by Shelley`} />
              <figcaption>
                <strong>{p.title}</strong>
                <span>{p.detail}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
      <div class="center mt-lg">
        <a href={mailto('Handmade masks or embroidery')} class="btn btn--ghost">Inquire about handmade pieces <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- Puzzles -->
  <section class="section" id="puzzles">
    <div class="container">
      <div class="gallery-head">
        <div class="section-head reveal" style="margin-bottom:0">
          <span class="eyebrow">Puzzles by Shelley</span>
          <h2>Piece together something <em class="accent">beautiful</em></h2>
        </div>
        <p class="lede reveal" style="max-width:40ch">Jigsaw puzzles from a quick 100-piece treat to a 1,000-piece panorama.</p>
      </div>
      <div class="puzzles">
        {
          puzzles.map((p, i) => (
            <article class="puzzle reveal" style={`--delay:${(i % 3) * 0.06}s`}>
              <div class="puzzle__art">
                <Photo photo={p} ratio="1/1" alt={`${p.title} puzzle`} />
                <span class="puzzle__pieces">
                  <Icon name="puzzle" size={16} /> {p.detail?.split(' · ')[0]}
                </span>
              </div>
              <h3>{p.title}</h3>
              {p.detail?.includes('·') && <p class="muted">{p.detail.split(' · ')[1]}</p>}
            </article>
          ))
        }
      </div>
      <div class="center mt-lg">
        <a href={mailto('Puzzle order')} class="btn btn--clay">Order a puzzle <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <CtaBand title='Don’t miss your chance at a <em class="accent" style="color:#f3b79f">one-of-a-kind</em> piece' text="Original paintings, mosaics, commissions, jewelry and handmade gifts are available. Tell Shelley what caught your eye." />
</Base>

<style>
  .palette-card {
    justify-self: end;
    width: 100%;
    max-width: 380px;
    padding: 1.6rem;
    border-radius: var(--radius-lg);
    background: var(--white);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    color: var(--ink-soft);
    display: grid;
    gap: 0.75rem;
  }
  .palette-card__title {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--forest-deep);
  }

  .gallery-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 1.5rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0.35rem;
    border-radius: 999px;
    background: var(--paper);
    border: 1px solid var(--line);
  }
  .filters button {
    padding: 0.55rem 1.1rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--ink-soft);
    cursor: pointer;
    transition:
      background-color 0.25s,
      color 0.25s;
  }
  .filters button span {
    font-size: 0.75rem;
    opacity: 0.6;
    margin-left: 0.2rem;
  }
  .filters button:hover {
    color: var(--forest-deep);
  }
  .filters button[aria-pressed='true'] {
    background: var(--forest);
    color: #fff;
  }
  @media (max-width: 600px) {
    .filters {
      border-radius: var(--radius);
    }
  }

  .masonry {
    list-style: none;
    padding: 0;
    columns: 3 260px;
    column-gap: 1.5rem;
  }
  .masonry li {
    break-inside: avoid;
    margin-bottom: 1.5rem;
    animation: fade-in 0.5s var(--ease) both;
  }
  .masonry li.is-hidden {
    display: none;
  }
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
  .work {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    text-align: left;
    cursor: zoom-in;
  }
  .work :global(.photo) {
    transition:
      transform 0.6s var(--ease),
      box-shadow 0.6s var(--ease);
  }
  .work:hover :global(.photo) {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
  }
  .work__meta {
    display: grid;
    padding: 0.7rem 0.2rem 0;
  }
  .work__meta strong {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.12rem;
    line-height: 1.25;
    color: var(--forest-deep);
  }
  .work__meta span {
    font-size: 0.84rem;
    color: var(--ink-mute);
  }

  .lightbox {
    width: min(1200px, 100vw - 2rem);
    max-width: none;
    max-height: calc(100vh - 2rem);
    padding: 0;
    border: 0;
    background: transparent;
    overflow: visible;
    margin: auto;
  }
  .lightbox[open] {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    animation: lb-in 0.4s var(--ease);
  }
  .lightbox::backdrop {
    background: rgb(24 43 32 / 0.9);
    backdrop-filter: blur(6px);
  }
  .lightbox figure {
    display: grid;
    justify-items: center;
    gap: 1rem;
    min-width: 0;
  }
  .lightbox img {
    max-width: 100%;
    max-height: calc(100vh - 9rem);
    width: auto;
    height: auto;
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
  }
  .lightbox figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 1rem;
    align-items: baseline;
    color: rgb(255 255 255 / 0.7);
    text-align: center;
  }
  .lightbox figcaption strong {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.4rem;
    color: #fff;
  }
  .lightbox__nav,
  .lightbox__close {
    display: grid;
    place-items: center;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.25);
    background: rgb(255 255 255 / 0.08);
    color: #fff;
    cursor: pointer;
    transition: background-color 0.25s;
  }
  .lightbox__nav:hover,
  .lightbox__close:hover {
    background: var(--clay);
  }
  .lightbox__nav--prev :global(svg) {
    rotate: 180deg;
  }
  .lightbox__close {
    position: fixed;
    top: 1rem;
    right: 1rem;
    z-index: 1;
  }
  @media (max-width: 700px) {
    .lightbox[open] {
      grid-template-columns: 1fr 1fr;
    }
    .lightbox figure {
      grid-column: 1 / -1;
      grid-row: 1;
    }
    .lightbox__nav--prev {
      justify-self: end;
    }
  }
  @keyframes lb-in {
    from {
      opacity: 0;
      transform: scale(0.97);
    }
  }

  .mosaic-photos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .mosaic-photos :global(.photo:nth-child(2)) {
    margin-top: 3rem;
  }
  .prices {
    margin-block: 2rem 1.5rem;
    border-top: 1px solid var(--line);
  }
  .prices div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--line);
  }
  .prices dt {
    color: var(--ink-soft);
  }
  .prices dd {
    margin: 0;
    font-weight: 600;
    color: var(--forest-deep);
    text-align: right;
  }

  .gems ul {
    list-style: none;
    padding: 0;
    margin-top: 1rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr));
    gap: 0.25rem 1.5rem;
  }
  .gems li {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    padding-block: 0.5rem;
    border-bottom: 1px dashed var(--line);
    font-size: 0.93rem;
  }
  .gems strong {
    font-weight: 600;
    color: var(--forest-deep);
  }
  .gems span {
    color: var(--ink-mute);
    text-align: right;
  }

  .handmade-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }
  @media (min-width: 800px) {
    .handmade-grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }
  .handmade-grid figcaption {
    display: grid;
    padding-top: 0.6rem;
  }
  .handmade-grid strong {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.05rem;
    color: var(--forest-deep);
  }
  .handmade-grid span {
    font-size: 0.82rem;
    color: var(--ink-mute);
  }

  .puzzles {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }
  @media (min-width: 700px) {
    .puzzles {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 1100px) {
    .puzzles {
      grid-template-columns: repeat(6, 1fr);
    }
  }
  .puzzle__art {
    position: relative;
    margin-bottom: 0.8rem;
  }
  .puzzle__art :global(.photo) {
    transition: transform 0.5s var(--ease);
  }
  .puzzle:hover .puzzle__art :global(.photo) {
    transform: rotate(-2deg) scale(1.02);
  }
  .puzzle__pieces {
    position: absolute;
    left: 0.6rem;
    bottom: 0.6rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.92);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--forest-deep);
  }
  .puzzle h3 {
    font-size: 1.15rem;
  }
</style>

<script>
  const gallery = document.querySelector<HTMLElement>('[data-gallery]')!;
  const items = [...gallery.querySelectorAll<HTMLLIElement>('li')];
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');

  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      items.forEach((li) => li.classList.toggle('is-hidden', f !== 'All' && li.dataset.medium !== f));
    }),
  );

  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]')!;
  const img = dialog.querySelector<HTMLImageElement>('[data-img]')!;
  const titleEl = dialog.querySelector<HTMLElement>('[data-title]')!;
  const mediumEl = dialog.querySelector<HTMLElement>('[data-medium]')!;
  let current = 0;

  const visible = () => items.filter((li) => !li.classList.contains('is-hidden'));
  const show = (li: HTMLLIElement) => {
    const thumb = li.querySelector('img')!;
    current = visible().indexOf(li);
    img.src = thumb.currentSrc || thumb.src;
    img.alt = thumb.alt;
    titleEl.textContent = li.querySelector('.work__meta strong')!.textContent;
    const detail = li.querySelector('.work__meta span')!.textContent;
    mediumEl.textContent = [li.dataset.medium, detail].filter(Boolean).join(' · ');
  };
  const step = (dir: number) => {
    const list = visible();
    show(list[(current + dir + list.length) % list.length]);
  };

  items.forEach((li) =>
    li.querySelector('.work')!.addEventListener('click', () => {
      show(li);
      dialog.showModal();
    }),
  );
  dialog.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());
  dialog.querySelector('[data-prev]')!.addEventListener('click', () => step(-1));
  dialog.querySelector('[data-next]')!.addEventListener('click', () => step(1));
  dialog.addEventListener('click', (e) => e.target === dialog && dialog.close());
  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') step(1);
    if (e.key === 'ArrowLeft') step(-1);
  });
</script>
