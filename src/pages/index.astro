---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { acrylic, mosaic, watercolor, digital, people } from '../data/gallery';

const find = (list: typeof acrylic, title: string) => list.find((p) => p.title === title)!;

const hero = {
  a: find(acrylic, 'Sailboats in Malibu'),
  b: find(acrylic, 'Bromeliad World'),
  c: find(mosaic, 'Stepping Stone — My Hand'),
};

const pillars = [
  {
    icon: 'ribbon',
    tone: 'icon-badge--clay',
    title: 'Cancer prevention education',
    text: 'Health awareness seminars educating the public on avoidable risks of cancer and illness from environmental toxins.',
    href: '/wellness/#cancer-prevention',
  },
  {
    icon: 'shield',
    tone: '',
    title: 'Safe products for body & home',
    text: 'Safe, trusted, non-toxic personal care, anti-aging, beauty and home cleaning products — and help reading every label.',
    href: '/wellness/#products',
  },
  {
    icon: 'palette',
    tone: 'icon-badge--gold',
    title: 'Fine impressionist art',
    text: 'Acrylics, watercolors, mosaics and digital art, plus healing gemstone jewelry, embroidery, masks and puzzles.',
    href: '/art/',
  },
  {
    icon: 'plant',
    tone: 'icon-badge--sky',
    title: 'Interior flowers & plantscapes',
    text: 'Since 1974, Creative Environments has brought clean air, beauty, peace and tranquility indoors with plants, trees and flowers.',
    href: '/community/#plantscapes',
  },
] as const;

const stats = [
  { value: '1974', label: 'Founded Creative Environments Flowers & Plantscapes' },
  { value: '1983', label: 'Began exhibiting art, from Santa Monica to NYC' },
  { value: '1987', label: 'Became LA Director of the Cancer Prevention Coalition' },
  { value: 'TV', label: 'Featured on NBC News and the BBC’s Sky 1' },
];

const tips = [
  { title: 'What’s really in it?', text: 'Before you buy, ask: what ingredients are in this product, and what do they mean? The most costly products are not always the best ones.' },
  { title: 'Look past the packaging', text: 'Some companies spend millions on advertising. Often a shampoo costs more simply because of its fancy container — the cap can cost more than what’s inside.' },
  { title: 'Take a little more time', text: 'Ask yourself: can I buy something better if I take more time to look and think about it? Informed choices protect your whole family.' },
];

const railPicks = [
  find(acrylic, 'Sitting on the Beach'),
  find(watercolor, 'The Malibu Pier'),
  find(acrylic, 'Hawaiian Houses'),
  find(mosaic, 'Front Door Tulips'),
  find(digital, 'Round the Bend in Malibu'),
  find(acrylic, 'Blue Chair in Garden'),
  find(digital, 'Water Lilies at Monet’s House'),
];
const mediumOf = (p: (typeof acrylic)[number]) =>
  acrylic.includes(p) ? 'Acrylic' : watercolor.includes(p) ? 'Watercolor' : mosaic.includes(p) ? 'Mosaic' : 'Digital';

const marquee = ['Your right to know', 'Safe, non-toxic products', 'Cancer prevention education', 'Pure essential oils', 'Impressionist art', 'Healing gemstone jewelry', 'Interior plantscapes', 'Malibu, California'];
---

<Base>
  <!-- HERO -->
  <section class="hero">
    <div class="hero__bg" aria-hidden="true"></div>
    <div class="container hero__grid">
      <div class="hero__copy">
        <span class="eyebrow reveal">Health · Wellness · Art</span>
        <h1 class="reveal" style="--delay:.08s">
          Your right to know what’s in <em class="accent">everyday</em> products.
        </h1>
        <p class="lede reveal" style="--delay:.16s">
          After losing her mom to cancer and surviving skin cancer herself, Shelley Marks-Kramer has spent decades helping
          people read labels, avoid harmful ingredients, and choose safe, trusted products for body and home.
        </p>
        <div class="btn-row reveal" style="--delay:.24s">
          <a href="/wellness/" class="btn">Explore wellness <Icon name="arrow" /></a>
          <a href="/art/" class="btn btn--ghost">View Shelley’s art</a>
        </div>
        <div class="hero__trust reveal" style="--delay:.32s">
          <img class="hero__face" src={people.portrait.src} alt="" width="52" height="52" />
          <p><strong>Shelley Marks-Kramer</strong><br />LA Director, Cancer Prevention Coalition · Artist</p>
        </div>
      </div>

      <div class="hero__art">
        <div class="hero__frame hero__frame--a"><Photo photo={hero.a} ratio="3/4" eager alt={`${hero.a.title}, acrylic painting by Shelley`} /></div>
        <div class="hero__frame hero__frame--b"><Photo photo={hero.b} ratio="1/1" eager alt={`${hero.b.title}, acrylic painting by Shelley`} /></div>
        <div class="hero__frame hero__frame--c"><Photo photo={hero.c} ratio="1/1" eager alt="Mosaic stepping stone of Shelley’s hand" /></div>
        <div class="hero__badge" aria-hidden="true">
          <span class="hero__badge-num">1974</span>
          <span>creating healthy,<br />beautiful spaces</span>
        </div>
      </div>
    </div>
  </section>

  <!-- MARQUEE -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {[...marquee, ...marquee].map((m) => <span><Icon name="sparkles" size={16} />{m}</span>)}
    </div>
  </div>

  <!-- PILLARS -->
  <section class="section">
    <div class="container">
      <div class="section-head section-head--center reveal">
        <span class="eyebrow">Here’s how I can help you</span>
        <h2>Treat yourself with <em class="accent">love</em> and affection</h2>
        <p class="lede">Learn how to live a healthy life with safe, pure and trusted products for body and home.</p>
      </div>
      <div class="grid grid-4">
        {
          pillars.map((p, i) => (
            <a href={p.href} class="card card--hover pillar reveal" style={`--delay:${i * 0.08}s`}>
              <span class={`icon-badge ${p.tone}`}>
                <Icon name={p.icon} />
              </span>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
              <span class="link-arrow">
                Learn more <Icon name="arrow" size={16} />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- STORY -->
  <section class="section section--paper story">
    <div class="container split">
      <div class="story__media reveal">
        <div class="portrait">
          <Photo photo={people.portrait} ratio="4/5" alt="Portrait of Shelley Marks-Kramer" />
        </div>
        <div class="story__quote">
          <Icon name="quote" size={22} />
          <p>I have made it my second half of life’s mission to educate the public on the risks of toxic ingredients in their daily used products.</p>
        </div>
      </div>
      <div class="story__copy">
        <span class="eyebrow reveal">Meet Shelley</span>
        <h2 class="reveal">A cancer survivor with a <em class="accent">mission</em></h2>
        <div class="prose reveal">
          <p>
            Shelley has been successfully self-employed, starting and running several of her own businesses, for more
            than three-quarters of her life. She holds several college degrees, certifications in nutritional and beauty
            consulting, and memberships in many health and wellness organizations.
          </p>
          <p>
            Her mom, “Miss Shirley Marks, Beauty Consultant from the House of Revlon,” died of cancer at just 56. Shelley
            has battled skin cancers since her teens. Together those experiences started her research into why there is
            so much cancer — and her commitment to telling the public what they deserve the right to know.
          </p>
        </div>
        <dl class="stats reveal">
          {
            stats.map((s) => (
              <div>
                <dt>{s.value}</dt>
                <dd>{s.label}</dd>
              </div>
            ))
          }
        </dl>
        <a href="/about/" class="btn btn--ghost reveal">Read Shelley’s story <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- TESTIMONIAL -->
  <section class="section section--tight">
    <div class="container">
      <figure class="testimonial reveal">
        <Icon name="quote" size={40} />
        <blockquote>
          Shelley is a vibrant, high energy, free spirit with a zest for life that is contagious. Her passion is to
          instill the joy of living a healthy life into those she meets and to awaken within people their full potential
          to help others share the benefits of living a healthy life.
        </blockquote>
        <figcaption><strong>Dr. Lauren Swerdloff, M.D.</strong> · Santa Monica</figcaption>
      </figure>
    </div>
  </section>

  <!-- INGREDIENT AWARENESS -->
  <section class="section section--paper">
    <div class="container split split--wide-left">
      <div>
        <div class="section-head reveal">
          <span class="eyebrow">Your decisions as health product consumers</span>
          <h2>“Which one should <em class="accent">I choose?</em>”</h2>
          <p class="lede">
            You probably ask yourself that question practically every day. The choices you make are important,
            especially when they concern your health.
          </p>
        </div>
        <ol class="tips">
          {
            tips.map((t, i) => (
              <li class="reveal" style={`--delay:${i * 0.08}s`}>
                <span class="tips__num">0{i + 1}</span>
                <div>
                  <h3>{t.title}</h3>
                  <p>{t.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <a href="/wellness/#consumer-guide" class="link-arrow mt-lg reveal">Become a wise health consumer <Icon name="arrow" size={16} /></a>
      </div>
      <div class="label-card reveal" aria-hidden="true">
        <div class="label-card__head">
          <Icon name="search" size={18} />
          <span>Reading a label with Shelley</span>
        </div>
        <ul>
          <li class="ok"><span>Zinc oxide (non-nano)</span><em>Mineral</em></li>
          <li class="ok"><span>Aloe barbadensis leaf juice</span><em>Plant-based</em></li>
          <li class="warn"><span>Parabens</span><em>Controversial</em></li>
          <li class="warn"><span>Sodium lauryl sulfate</span><em>Questionable</em></li>
          <li class="warn"><span>Formaldehyde releasers</span><em>Avoid</em></li>
        </ul>
        <div class="label-card__foot">
          <span class="pill"><Icon name="shield" size={14} /> “I am happy to help you read labels.”</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ART SHOWCASE -->
  <section class="section section--forest art-show">
    <div class="container">
      <div class="art-show__head">
        <div class="section-head reveal">
          <span class="eyebrow" style="color:#f3b79f">Fine impressionist art</span>
          <h2>Oceanscapes, landscapes &amp; <em class="accent" style="color:#f3b79f">windowscapes</em></h2>
          <p class="lede" style="color:rgb(231 239 230 / .8)">
            Shelley has shown her artwork since 1983 across the United States, from Santa Monica to New York City, and
            has collectors across the U.S. All artwork is for sale — ask about pricing.
          </p>
        </div>
        <a href="/art/" class="btn btn--light reveal">Visit the gallery <Icon name="arrow" /></a>
      </div>
    </div>
    <div class="art-rail" tabindex="0" aria-label="Featured artwork">
      {
        railPicks.map((g, i) => (
          <a href="/art/" class={`art-rail__item reveal ${i % 2 ? 'is-offset' : ''}`} style={`--delay:${i * 0.06}s`}>
            <Photo photo={g} ratio="4/5" />
            <span class="art-rail__meta">
              <strong>{g.title}</strong>
              <span>{mediumOf(g)}</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <CtaBand />
</Base>


<style>
  /* Hero */
  .hero {
    position: relative;
    padding-block: clamp(8rem, 14vw, 11rem) clamp(4rem, 8vw, 6rem);
    overflow: hidden;
    isolation: isolate;
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(45% 55% at 85% 20%, rgb(196 105 74 / 0.18), transparent 65%),
      radial-gradient(40% 50% at 60% 90%, rgb(143 188 203 / 0.28), transparent 65%),
      radial-gradient(45% 60% at 0% 30%, rgb(138 164 135 / 0.25), transparent 65%),
      var(--cream);
  }
  .hero__grid {
    display: grid;
    gap: clamp(3rem, 6vw, 5rem);
    align-items: center;
  }
  @media (min-width: 980px) {
    .hero__grid {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }
  .hero h1 {
    margin-block: 1.3rem 1.5rem;
  }
  .hero .btn-row {
    margin-top: 2.2rem;
  }
  .hero__trust {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 2.5rem;
    font-size: 0.92rem;
    color: var(--ink-soft);
  }
  .hero__trust strong {
    color: var(--forest-deep);
  }
  .hero__face {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    object-fit: cover;
    object-position: top;
    border: 3px solid #fff;
    box-shadow: var(--shadow-sm);
  }

  .hero__art {
    position: relative;
    aspect-ratio: 1 / 1.05;
    max-width: 560px;
    width: 100%;
    margin-inline: auto;
  }
  .hero__frame {
    position: absolute;
    border-radius: var(--radius-lg);
    padding: 10px;
    background: #fff;
    box-shadow: var(--shadow-lg);
    animation: float 9s ease-in-out infinite;
  }
  .hero__frame :global(.photo) {
    border-radius: calc(var(--radius-lg) - 8px);
  }
  .hero__frame--a {
    width: 60%;
    left: 4%;
    top: 0;
    rotate: -4deg;
  }
  .hero__frame--b {
    width: 46%;
    right: 0;
    top: 18%;
    rotate: 5deg;
    animation-delay: -3s;
  }
  .hero__frame--c {
    width: 38%;
    left: 30%;
    bottom: 0;
    rotate: -2deg;
    animation-delay: -6s;
  }
  .hero__badge {
    position: absolute;
    right: 4%;
    bottom: 10%;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.9rem 1.2rem;
    border-radius: 999px;
    background: var(--forest);
    color: #fff;
    font-size: 0.8rem;
    line-height: 1.2;
    box-shadow: var(--shadow);
  }
  .hero__badge-num {
    font-family: var(--font-display);
    font-size: 2rem;
    color: #f3b79f;
  }
  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-12px);
    }
  }

  /* Marquee */
  .marquee {
    overflow: hidden;
    border-block: 1px solid var(--line);
    background: var(--white);
    padding-block: 1.1rem;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .marquee__track {
    display: flex;
    gap: 3rem;
    width: max-content;
    animation: marquee 45s linear infinite;
  }
  .marquee span {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: var(--forest);
    white-space: nowrap;
  }
  .marquee span :global(svg) {
    color: var(--clay);
  }
  @keyframes marquee {
    to {
      transform: translateX(calc(-50% - 1.5rem));
    }
  }

  .pillar {
    display: flex;
    flex-direction: column;
    text-decoration: none;
  }
  .pillar p {
    flex: 1;
    margin-bottom: 1.5rem;
  }

  /* Story */
  .story__media {
    position: relative;
    padding-bottom: 3rem;
  }
  .portrait {
    position: relative;
    max-width: 460px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .portrait :global(.photo) {
    border-radius: 0;
  }
  .testimonial {
    max-width: 900px;
    margin-inline: auto;
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 1.5rem;
  }
  .testimonial :global(svg) {
    color: var(--clay);
  }
  .testimonial blockquote {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.6vw, 2.1rem);
    line-height: 1.35;
    color: var(--forest-deep);
    text-wrap: balance;
  }
  .testimonial figcaption {
    color: var(--ink-mute);
  }
  .testimonial figcaption strong {
    color: var(--forest-deep);
  }
  .portrait__caption {
    position: absolute;
    inset: 0 0 auto;
    display: grid;
    padding: 1.4rem 1.5rem 4rem;
    background: linear-gradient(rgb(24 43 32 / 0.75), transparent);
    color: rgb(255 255 255 / 0.8);
    font-size: 0.85rem;
  }
  .portrait__name {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: #fff;
  }
  .story__quote {
    position: absolute;
    right: 0;
    bottom: 0;
    max-width: 300px;
    padding: 1.4rem 1.5rem;
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: var(--shadow);
    font-family: var(--font-display);
    font-size: 1.1rem;
    line-height: 1.35;
    color: var(--forest-deep);
  }
  .story__quote :global(svg) {
    color: var(--clay);
    margin-bottom: 0.6rem;
  }
  @media (max-width: 600px) {
    .story__quote {
      position: relative;
      margin: -2.5rem 0 0 auto;
      max-width: 88%;
    }
    .story__media {
      padding-bottom: 0;
    }
  }
  .story__copy h2 {
    margin-block: 1rem 1.5rem;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem 2rem;
    margin-block: 2.5rem;
    padding-block: 2rem;
    border-block: 1px solid var(--line);
  }
  .stats dt {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.4vw, 2.6rem);
    line-height: 1;
    color: var(--clay);
    margin-bottom: 0.4rem;
  }
  .stats dd {
    margin: 0;
    font-size: 0.92rem;
    color: var(--ink-soft);
  }

  /* Tips */
  .tips {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .tips li {
    display: flex;
    gap: 1.25rem;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--line);
  }
  .tips__num {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--clay);
    padding-top: 0.2rem;
  }
  .tips h3 {
    margin-bottom: 0.3rem;
  }
  .tips p {
    color: var(--ink-soft);
  }
  .label-card {
    align-self: center;
    background: var(--white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: 1.6rem;
    rotate: 2deg;
    border: 1px solid var(--line);
  }
  .label-card__head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    color: var(--forest-deep);
    padding-bottom: 1rem;
    border-bottom: 1px dashed var(--line);
  }
  .label-card ul {
    list-style: none;
    padding: 0;
  }
  .label-card li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 0;
    border-bottom: 1px dashed var(--line);
    font-size: 0.93rem;
  }
  .label-card li em {
    font-style: normal;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    white-space: nowrap;
    align-self: center;
  }
  .label-card li.ok em {
    background: var(--sage-soft);
    color: var(--forest);
  }
  .label-card li.warn em {
    background: var(--clay-soft);
    color: var(--clay-deep);
  }
  .label-card__foot {
    padding-top: 1.2rem;
  }

  /* Art showcase */
  .art-show {
    overflow: hidden;
  }
  .art-show__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }
  .art-show__head .section-head {
    margin-bottom: 0;
  }
  .art-rail {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    padding: 0 var(--gutter) 2.5rem max(var(--gutter), calc((100vw - var(--container)) / 2 + var(--gutter)));
    scroll-snap-type: x mandatory;
    scroll-padding-inline: max(var(--gutter), calc((100vw - var(--container)) / 2 + var(--gutter)));
    scrollbar-width: thin;
    scrollbar-color: rgb(255 255 255 / 0.3) transparent;
  }
  .art-rail__item {
    flex: 0 0 clamp(230px, 26vw, 320px);
    scroll-snap-align: start;
    text-decoration: none;
    color: #fff;
  }
  .art-rail__item.is-offset {
    margin-top: 2.5rem;
  }
  .art-rail__item :global(.photo) {
    transition: transform 0.6s var(--ease);
  }
  .art-rail__item:hover :global(.photo) {
    transform: scale(1.03) rotate(-0.6deg);
  }
  .art-rail__meta {
    display: flex;
    justify-content: space-between;
    padding-top: 0.9rem;
    font-size: 0.9rem;
  }
  .art-rail__meta strong {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.15rem;
  }
  .art-rail__meta span {
    color: rgb(231 239 230 / 0.6);
  }
</style>
