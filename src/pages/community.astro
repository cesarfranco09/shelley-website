---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { floral, watercolor } from '../data/gallery';
import { mailto } from '../data/site';

const benefits = [
  'Plants decrease employee stress and enhance productivity',
  'Plants contribute oxygen in “Green Building” programs',
  'Plants in the workplace help attract and retain employees',
  'Plantscaping helps create energy efficiency without Sick Building Syndrome',
];

const kids = [
  { name: 'Best Buddies', note: 'Helping people with intellectual and developmental disabilities find jobs and friendships', href: 'https://www.bestbuddies.org/' },
  { name: 'KidsHealth', note: 'Doctor-reviewed health information for parents, kids and teens', href: 'https://kidshealth.org/' },
  { name: 'Healthy Child Healthy World', note: 'Protecting children from harmful chemicals', href: 'https://www.healthychild.org/' },
];

const links = [
  { name: 'Campaign for Safe Cosmetics', href: 'https://www.safecosmetics.org/' },
  { name: 'Environmental Working Group', href: 'https://www.ewg.org/' },
  { name: 'Silent Spring Institute', href: 'https://www.silentspring.org/' },
  { name: 'National Breast Cancer Foundation', href: 'https://www.nationalbreastcancer.org/' },
  { name: 'Prevent Blindness', href: 'https://preventblindness.org/' },
  { name: 'Poison Control', href: 'https://www.poison.org/' },
  { name: 'Environment California', href: 'https://environmentamerica.org/california/' },
  { name: 'Hale & Hush — sensitive skin products', href: 'https://haleandhush.com/' },
];

const brickGarden = watercolor.find((w) => w.title.startsWith('A Real Garden'))!;
const floralGrid = floral.filter((f) => !['Coleus', 'Hill Street Patio'].includes(f.title)).slice(0, 8);
---

<Base title="Community" description="Creative Environments interior flowers and plantscapes since 1974, the Malibu Garden Club, children’s resources and trusted health links from Shelley Marks-Kramer.">
  <PageHero
    eyebrow="Community & resources"
    title='Rooted in <em class="accent">Malibu</em>, growing together'
    lede="Flowers and plants provide beauty, peace and tranquility for your eyes, nose and senses, and open up the beauty in the world and the pathway to your heart."
  />

  <!-- Plantscapes -->
  <section class="section" id="plantscapes">
    <div class="container split" style="align-items:start">
      <div>
        <span class="eyebrow reveal">Creative Environments · Since 1974</span>
        <h2 class="reveal" style="margin-block:1rem 1.25rem">Interior flowers &amp; <em class="accent">plantscapes</em></h2>
        <div class="prose reveal">
          <p>
            Shelley started Creative Environments in 1974, creating tropical paradises with interior plants, trees, floral
            arrangements and artwork for homes, offices, restaurants and clothing showrooms in the LA Clothing Mart — for
            lawyers, celebrities and the entertainment industry.
          </p>
          <p>
            She maintains them with weekly, bi-monthly or monthly service, including fertilizing, cutting and dusting leaves,
            and creates floral arrangements for parties, weddings, graduations, bar and bat mitzvahs and office parties.
          </p>
          <p>
            Shelley is a founding member of the California Interior Plantscape Association, was featured on NBC’s 6 pm news
            in 1978 as a professional plant interiorscaper, and in 2003 appeared on the BBC’s Sky 1 as flower and plant lady
            to the stars.
          </p>
        </div>
        <div class="tv reveal">
          <a href="/about/#videos" class="tv__item"><Icon name="tv" /> <span><strong>NBC News, 1978</strong> Watch the segment</span></a>
          <div class="tv__item"><Icon name="tv" /> <span><strong>BBC Sky 1, 2003</strong> “Plant Lady to the Stars”</span></div>
        </div>
        <a href={mailto('Creative Environments — plants & flowers')} class="btn btn--clay reveal" style="margin-top:2rem">Book plants or flowers <Icon name="arrow" /></a>
      </div>
      <div class="floral reveal" style="--delay:.1s">
        {floralGrid.map((f) => <Photo photo={f} ratio="4/5" alt={`${f.title} by Creative Environments`} />)}
      </div>
    </div>
  </section>

  <!-- NASA -->
  <section class="section section--paper">
    <div class="container split">
      <div class="reveal">
        <Photo photo={brickGarden} alt="Watercolor of a real garden by Creative Environments" />
        <p class="muted caption">Watercolor of a real garden by Creative Environments, 24 × 30</p>
      </div>
      <div>
        <span class="eyebrow reveal">Why plants matter</span>
        <h2 class="reveal" style="margin-block:1rem 1.25rem">Cleaner air, <em class="accent">naturally</em></h2>
        <p class="lede reveal">
          NASA research on indoor air found that one potted plant per 100 square feet of floor space can help clean the air
          in the average home or office.
        </p>
        <blockquote class="quote reveal">
          “Low levels of chemicals, such as carbon monoxide and formaldehyde, can be removed from indoor environments by plant
          leaves alone.”
          <cite>Dr. William Wolverton, NASA principal investigator</cite>
        </blockquote>
        <ul class="check-list reveal">
          {benefits.map((b) => <li>{b}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- Garden club -->
  <section class="section" id="garden-club">
    <div class="container">
      <div class="club reveal">
        <div class="club__badge">
          <span>Est.</span>
          <strong>1956</strong>
        </div>
        <div class="club__body">
          <span class="eyebrow">Malibu Garden Club</span>
          <h2>Where neighbors grow <em class="accent">beautiful things</em></h2>
          <p class="lede">
            Shelley serves on the board of the Malibu Garden Club, established in 1956. The club has traditionally met on the
            first Wednesday of the month at the Point Dume Clubhouse, 29500 Heathercliff Road, from 9:30 to 11:30 am.
          </p>
          <div class="btn-row">
            <a href="https://malibugardenclub.org/" class="btn" target="_blank" rel="noopener">MalibuGardenClub.org <Icon name="external" /></a>
            <a href="https://organicgardenclubofventuracounty.org/" class="btn btn--ghost" target="_blank" rel="noopener">Organic Garden Club of Ventura County <Icon name="external" /></a>
          </div>
          <p class="muted" style="font-size:.9rem">Please check the club’s website for the current meeting schedule.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Resources -->
  <section class="section section--paper" id="resources">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Links &amp; resources</span>
        <h2>Helpful information for <em class="accent">every</em> household</h2>
        <p class="lede">
          Trusted organizations with information on chemicals in everyday products, safe alternatives, and health for men,
          women, children and the environment.
        </p>
      </div>
      <div class="split" style="align-items:start">
        <div class="card reveal">
          <span class="icon-badge icon-badge--clay"><Icon name="heart" /></span>
          <h3>Children’s resources</h3>
          <ul class="res">
            {
              kids.map((k) => (
                <li>
                  <a href={k.href} target="_blank" rel="noopener">
                    {k.name} <Icon name="external" size={14} />
                  </a>
                  <span>{k.note}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="card reveal" style="--delay:.08s">
          <span class="icon-badge"><Icon name="book" /></span>
          <h3>Health &amp; environment links</h3>
          <ul class="res res--cols">
            {
              links.map((l) => (
                <li>
                  <a href={l.href} target="_blank" rel="noopener">
                    {l.name} <Icon name="external" size={14} />
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="muted" style="font-size:.85rem;margin-top:1rem">
            These links go to other websites. Healthy Communications is not responsible for the privacy practices or content
            of those sites.
          </p>
        </div>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .floral {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  .floral > :global(.photo:nth-child(even)) {
    translate: 0 2.5rem;
  }
  .tv {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .tv__item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.2rem;
    border-radius: var(--radius);
    background: var(--white);
    border: 1px solid var(--line);
    text-decoration: none;
    color: var(--clay-deep);
  }
  .tv__item span {
    display: grid;
    color: var(--ink-soft);
    font-size: 0.9rem;
  }
  .tv__item strong {
    color: var(--forest-deep);
    font-size: 1rem;
  }
  a.tv__item:hover {
    border-color: var(--clay);
  }
  .caption {
    font-size: 0.85rem;
    margin-top: 0.6rem;
  }
  .quote {
    margin-block: 1.5rem;
    padding: 1.25rem 1.5rem;
    border-left: 3px solid var(--sage);
    background: var(--white);
    border-radius: 0 var(--radius) var(--radius) 0;
    font-family: var(--font-display);
    font-size: 1.15rem;
    line-height: 1.4;
    color: var(--forest-deep);
  }
  .quote cite {
    display: block;
    margin-top: 0.6rem;
    font-family: var(--font-body);
    font-style: normal;
    font-size: 0.85rem;
    color: var(--ink-mute);
  }

  .club {
    display: grid;
    gap: 2rem;
    align-items: center;
    padding: clamp(2rem, 5vw, 3.5rem);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(60% 90% at 100% 0%, rgb(138 164 135 / 0.3), transparent 70%),
      var(--sage-soft);
  }
  @media (min-width: 800px) {
    .club {
      grid-template-columns: auto 1fr;
      gap: 3rem;
    }
  }
  .club__badge {
    display: grid;
    place-items: center;
    width: 140px;
    height: 140px;
    border-radius: 50%;
    background: var(--clay);
    color: #fff;
    line-height: 1;
    box-shadow: var(--shadow);
    rotate: -6deg;
  }
  .club__badge span {
    font-size: 0.8rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-top: 1.8rem;
  }
  .club__badge strong {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 2.4rem;
    margin-bottom: 1.8rem;
  }
  .club__body {
    display: grid;
    gap: 1.1rem;
    min-width: 0;
  }
  .club__body .btn {
    white-space: normal;
    text-align: center;
  }

  .res {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.9rem;
    margin-top: 1rem;
  }
  .res--cols {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 230px), 1fr));
    gap: 0.6rem 1.5rem;
  }
  .res li {
    display: grid;
  }
  .res a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 600;
    color: var(--forest-deep);
    text-decoration: none;
  }
  .res a:hover {
    color: var(--clay-deep);
  }
  .res span {
    font-size: 0.9rem;
    color: var(--ink-soft);
  }
</style>
